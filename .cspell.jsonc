{
  "version": "0.2",
  "import": [
    ".cspell/cesium/cspell-ext.json"
  ],
  "ignorePaths": [
    ".cspell.json*",
    ".cspell/**",
    ".git/**",
    "*.code-workspace",
    ".gitignore",
    ".local-gitignore",
    ".env",
    "package-lock.json",
    "node_modules/**",
    "zig-out/**",
    ".zig-cache/**",
    "zig-pkg/**",
    "site/content/**",
    "grammar/**",
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".vscode/ltex.dictionary.en-US.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "bash",
    "win32",
    "scientific-terms-us",
    "zig",
    "cesium",
    "project-words",
  ],
  "allowCompoundWords": true,
  "words": [
    "CMake",
  ],
  "ignoreWords": [],
  "ignoreRegExpList": [
    "/-D.*/",
    "/-W.*/",
  ]
}
