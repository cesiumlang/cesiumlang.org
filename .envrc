#!/usr/bin/env bash
# direnv: the tools for this repository.

# The Zig of the Cesium devkit builds the site (bash tools/fetch-devkit.sh in
# cesiumlang/cesium): next to this repository in cesium-workspace, or a clone
# of the compiler in cesium-src/, as CI makes
if [ -d ../cesium-src/.devkit/zig ]; then
  PATH_add ../cesium-src/.devkit/zig
elif [ -d cesium-src/.devkit/zig ]; then
  PATH_add cesium-src/.devkit/zig
fi
