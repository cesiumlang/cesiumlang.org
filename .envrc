#!/usr/bin/env bash
# direnv: the tools for this repository and its submodules.

# Node.js for Quartz and build.js: the version in .node-version, through fnm
if has fnm; then
  eval "$(fnm env --shell bash)"
  fnm use --install-if-missing --silent-if-unchanged
fi

# cesium-src: the Cesium devkit (Zig, QBE) and the compiler's build outputs
source_env_if_exists cesium-src/.envrc
