#!/usr/bin/env bash
# direnv: the tools for this repository.

# The Zig of the Cesium devkit builds the site here (bash tools/fetch-devkit.sh
# in cesiumlang/cesium), next to this repository in cesium-workspace. CI uses
# the Zig set by hand in deploy.yml: keep the two the same.
if [ -d ../cesium-src/.devkit/zig ]; then
  PATH_add ../cesium-src/.devkit/zig
fi
