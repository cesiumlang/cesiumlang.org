{
  "ignores": [
    "private/**",
    "content/chatgpt/**/*",
    "content/claude/**/*",
    "node_modules/**",
    // build output and the mirrored workspace
    "zig-out/**",
    ".zig-cache/**",
    "zig-pkg/**",
    "site/content/**",
    // submodules: each has its own repository and rules
    "cesium-src/**",
    "grammar/**",
    ".cspell/**"
  ]
}
